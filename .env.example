# Local AI (no API keys required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
WHISPER_MODEL=base.en
STT_PROVIDER=local_whisper
# Voice input uses a local microphone and Faster-Whisper. No API key required.
TTS_PROVIDER=piper
TTS_VOICE=en_US-lessac-medium
PIPER_BIN=piper
PIPER_MODEL=voices/en_US-lessac-medium.onnx
TTS_ENABLED=false
STT_LANGUAGE=en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
MIC_SILENCE_DURATION=0.8
MIC_SPEECH_TIMEOUT=10
MIC_MAX_RECORDING_DURATION=20
MIC_ENERGY_THRESHOLD=0.012

# Local service and memory settings
MCP_SERVER_PORT=8000
FRIDAY_MEMORY_DIR=memory
ASSISTANT_NAME=FRIDAY
DEBUG_TOOLS=false
WORLD_MONITOR_URL=https://worldmonitor.app/
MAX_TOOL_ITERATIONS=5
